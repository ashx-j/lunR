exports[`run-prompt tool results > describes deferred acceptance and rejection in the enabled tool contract 1`] = `
{
  "description": "Queue a prompt template command to execute when the current turn ends. Pass the template name and any arguments. A queued result confirms acceptance, not completion. Rejected requests fail without changing the queue; wait for queued or running work to finish before retrying. Supports --loop for loops (e.g. 'deslop --loop 5', 'deslop --loop=5', 'deslop --loop' for unlimited until convergence with a 999-iteration cap), --fresh for context collapse between iterations, and --no-converge to disable early stopping for bounded loops. Supports runtime delegation override via --subagent, --subagent=<name>, or --subagent:<name>. Use 'chain-prompts template1 -> template2' for chaining and add --chain-context to pass previous step summaries into delegated steps.",
  "name": "run-prompt",
  "parameters": {
    "properties": {
      "command": {
        "description": "Template name and arguments (e.g. 'deslop --loop 5 --fresh', 'deslop --subagent:worker', 'deslop --subagent', 'chain-prompts analyze -> fix --chain-context', 'chain-prompts analyze -> fix --loop=3')",
        "type": "string",
      },
    },
    "required": [
      "command",
    ],
    "type": "object",
  },
  "promptSnippet": "Use this to run slash/prompt templates by name with args (including --loop/--fresh and chain-prompts flows) when the user asks to execute a prompt template.",
}
`;
